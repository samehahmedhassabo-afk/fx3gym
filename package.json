{
  "name": "fx3",
  "version": "0.1.0",
  "private": true,
  "description": "FX3 Fight & Fitness Centre — gym management system",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "db:migrate": "prisma migrate dev",
